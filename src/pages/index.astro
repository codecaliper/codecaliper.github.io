---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { links } from '../data/links';

const topics = ['Homelab builds', 'Self-hosted apps', 'Kubernetes & Proxmox', 'Tips & tricks'];
---

<Base>
  <canvas id="bg" class="bg" aria-hidden="true"></canvas>

  <div class="toolbar">
    <button id="terminal-toggle" class="tool" type="button" aria-label="Open terminal" aria-controls="terminal" aria-expanded="false" title="Terminal (`)">
      <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
    </button>
    <button id="theme-toggle" class="tool" type="button" aria-label="Toggle light or dark theme" title="Toggle theme">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
    </button>
    <button id="share" class="tool" type="button" aria-label="Share this page" title="Share">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"></line><line x1="15.4" y1="6.5" x2="8.6" y2="10.5"></line></svg>
    </button>
  </div>

  <main>
    <header>
      <img class="logo" src="/logo.svg" alt="CodeCaliper logo" width="160" height="160" />
      <h1 class="sr-only">CodeCaliper</h1>
      <p class="tagline">
        <span class="sr-only">Homelab setups, self-hosted apps and services, Kubernetes &amp; Proxmox, tips &amp; tricks.</span>
        <span id="typed" aria-hidden="true"></span><span class="caret" aria-hidden="true"></span>
      </p>
      <ul class="topics">
        {topics.map((topic) => <li>{topic}</li>)}
      </ul>
    </header>

    <nav aria-label="Social links">
      {
        links.map((link) => (
          <a class="link" href={link.href} target="_blank" rel="noopener noreferrer">
            <Icon name={link.icon} />
            <span class="label">{link.label}</span>
            <span class="handle">{link.handle}</span>
            <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
          </a>
        ))
      }
    </nav>

    <p class="hint">Press <kbd>`</kbd> to open the terminal</p>
    <footer>© {new Date().getFullYear()} CodeCaliper</footer>
  </main>

  <section id="terminal" class="terminal" role="dialog" aria-label="CodeCaliper terminal" hidden>
    <div class="term-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="term-title">guest@codecaliper: ~</span>
      <button id="term-close" class="term-close" type="button" aria-label="Close terminal">×</button>
    </div>
    <div id="term-out" class="term-out" aria-live="polite"></div>
    <form id="term-form" class="term-form">
      <label for="term-in" class="prompt">guest@codecaliper:~$</label>
      <input id="term-in" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="send" />
    </form>
  </section>

  <div id="toast" class="toast" role="status" aria-live="polite"></div>
  <canvas id="confetti" class="confetti" aria-hidden="true"></canvas>
</Base>

<script>
  import '../scripts/main';
</script>

<style>
  .bg,
  .confetti {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  .bg {
    z-index: 0;
  }

  .confetti {
    z-index: 50;
    width: 100%;
    height: 100%;
  }

  .toolbar {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 20;
    display: flex;
    gap: 0.5rem;
  }

  .tool {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--text);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, transform 0.15s;
  }

  .tool:hover,
  .tool:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .tool svg,
  .arrow {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global([data-theme='dark']) .moon,
  :global([data-theme='light']) .sun {
    display: none;
  }

  main {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    margin: 0 auto;
    padding: 4rem 1.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  header {
    text-align: center;
  }

  .logo {
    display: block;
    width: 10rem;
    height: 10rem;
    margin: 0 auto 0.5rem;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.3s;
    filter: drop-shadow(0 0 18px rgb(var(--accent-rgb) / 0.25));
  }

  .logo:hover {
    transform: scale(1.04) rotate(-2deg);
  }

  .logo:global(.spin) {
    animation: spin 1s ease-in-out;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg) scale(1.1);
    }
  }

  .tagline {
    min-height: 1.6em;
    margin: 0.5rem 0 1rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  #typed {
    color: var(--text);
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .topics {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 24rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  .topics li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    color: var(--muted);
    background: var(--card);
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }

  .topics li::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px rgb(var(--accent-rgb) / 0.6);
  }

  .topics li:hover {
    color: var(--text);
    border-color: rgb(var(--accent-rgb) / 0.5);
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link {
    --mx: 50%;
    --my: 50%;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.95rem 1.1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }

  .link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(220px circle at var(--mx) var(--my), rgb(var(--accent-rgb) / 0.16), transparent 70%);
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }

  .link:hover,
  .link:focus-visible {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -12px rgb(var(--accent-rgb) / 0.5);
  }

  .link:hover::before,
  .link:focus-visible::before {
    opacity: 1;
  }

  .link > :global(svg:first-child) {
    transition: color 0.15s, transform 0.15s;
  }

  .link:hover > :global(svg:first-child) {
    color: var(--accent);
    transform: scale(1.12);
  }

  .label {
    font-weight: 600;
  }

  .handle {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .arrow {
    color: var(--muted);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.15s, transform 0.15s;
  }

  .link:hover .arrow,
  .link:focus-visible .arrow {
    opacity: 1;
    color: var(--accent);
    transform: none;
  }

  .hint {
    margin: 0;
    text-align: center;
    color: var(--muted);
    font-size: 0.8rem;
  }

  kbd {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 0.3rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background: var(--card);
  }

  @media (hover: none) {
    .hint {
      display: none;
    }
  }

  footer {
    text-align: center;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .terminal {
    position: fixed;
    z-index: 30;
    left: 50%;
    bottom: 1.5rem;
    width: min(42rem, calc(100vw - 2rem));
    height: min(24rem, 60vh);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    background: var(--terminal-bg);
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.6), 0 0 0 1px rgb(var(--accent-rgb) / 0.08);
    backdrop-filter: blur(10px);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85rem;
    animation: rise 0.2s ease-out;
  }

  .terminal[hidden] {
    display: none;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translate(-50%, 12px);
    }
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }

  .dots {
    display: flex;
    gap: 0.35rem;
  }

  .dots i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #ff5f57;
  }

  .dots i:nth-child(2) {
    background: #febc2e;
  }

  .dots i:nth-child(3) {
    background: #28c840;
  }

  .term-title {
    flex: 1;
    text-align: center;
  }

  .term-close {
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }

  .term-close:hover {
    color: var(--text);
  }

  .term-out {
    flex: 1;
    overflow-y: auto;
    padding: 0.8rem 0.9rem 0.2rem;
  }

  .term-out :global(.term-line) {
    white-space: pre-wrap;
    word-break: break-word;
  }

  .term-out :global(a) {
    color: var(--accent);
  }

  .prompt,
  .term-out :global(.prompt) {
    color: var(--accent);
  }

  .term-form {
    display: flex;
    gap: 0.5rem;
    padding: 0.2rem 0.9rem 0.8rem;
  }

  .term-form input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    caret-color: var(--accent);
  }

  .toast {
    position: fixed;
    z-index: 60;
    left: 50%;
    top: 1.25rem;
    transform: translate(-50%, -150%);
    padding: 0.6rem 1rem;
    background: var(--card);
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-size: 0.9rem;
    opacity: 0;
    visibility: hidden;
    transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s;
    pointer-events: none;
  }

  .toast:global(.show) {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  @media (max-width: 480px) {
    .toolbar {
      top: 0.75rem;
      right: 0.75rem;
    }

    main {
      padding-top: 4.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
