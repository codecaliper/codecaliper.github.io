---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'CodeCaliper',
  description = 'Homelab builds, self-hosted apps, and tips & tricks. Videos on YouTube, TikTok, and Instagram.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/logo.png', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0b0f14" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light') theme = 'dark';
        document.documentElement.dataset.theme = theme;
        if (theme === 'light') document.querySelector('meta[name="theme-color"]').content = '#f6f8fa';
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b0f14;
    --card: #131a22;
    --card-hover: #1a2430;
    --border: #233040;
    --text: #e6edf3;
    --muted: #8b98a5;
    --accent: #5ef2d4;
    --accent-rgb: 94 242 212;
    --glow: rgba(94, 242, 212, 0.12);
    --terminal-bg: rgba(8, 12, 16, 0.94);
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }

  :root[data-theme='light'] {
    color-scheme: light;
    --bg: #f6f8fa;
    --card: #ffffff;
    --card-hover: #f0fdfa;
    --border: #d0d7de;
    --text: #1f2328;
    --muted: #57606a;
    --accent: #0d9488;
    --accent-rgb: 13 148 136;
    --glow: rgba(13, 148, 136, 0.1);
    --terminal-bg: rgba(255, 255, 255, 0.96);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 50% -20%, var(--glow), transparent 60%),
      var(--bg);
    color: var(--text);
    line-height: 1.5;
    transition: background-color 0.3s, color 0.3s;
  }

  a {
    color: inherit;
  }
</style>
