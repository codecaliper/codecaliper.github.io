---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CodeCaliper',
  description = 'Homelab builds, self-hosted apps, and tips & tricks. Videos on YouTube, TikTok, and Instagram.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/logo.png', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0b0f14" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b0f14;
    --card: #131a22;
    --card-hover: #1a2430;
    --border: #233040;
    --text: #e6edf3;
    --muted: #8b98a5;
    --accent: #5ef2d4;
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 50% -20%, rgba(94, 242, 212, 0.12), transparent 60%),
      var(--bg);
    color: var(--text);
    line-height: 1.5;
  }

  a {
    color: inherit;
  }
</style>
